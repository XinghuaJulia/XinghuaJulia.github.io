---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { formatPostDate, postSlug } from '../lib/posts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Your Name',
  jobTitle: 'I have a job ??? :o',
  url: 'https://xinghuajulia.github.io',
  sameAs: [
    'https://github.com/XinghuaJulia',
    'https://www.linkedin.com/in/xiner-lin-julia',
  ],
  // Escape < so no value can ever close the inline <script> tag.
}).replace(/</g, '\\u003c');
---

<Layout
  title="Coding Pen's Repo"
  description="My braindump of all things: OSINT, puzzles, and art :>"
  canonicalPath="/"
>
  <script type="application/ld+json" is:inline set:html={personSchema} />
  <main class="content-shell home-landing">
    <div class="home-background" aria-hidden="true">
      <img
        src="/assets/challenge.jpg"
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="home-landing-content">
      <div class="page-hero">
        <h1 class="visually-hidden">Home</h1>
        <TypedLede text="Psst. I have a challenge for you." />
        <!-- The image is here but where did the questions go?
        Accept my first challenge. 
        What do they have in common: ASTRO BOY, A.M., AX400 -->
      </div>

      <section class="section" aria-label="Recent posts">
        {posts.length === 0 ? (
          <p class="empty-note">No posts yet, check back soon :3</p>
        ) : (
          <nav class="commit-tree" aria-label="Recent posts">
            <a class="commit-tree-head" href="/blog/" title="All posts">Blog</a>
            {posts.map((post) => (
              <a href={`/blog/${postSlug(post)}/`}>
                {post.data.title}
                <span class="commit-tree-date">{formatPostDate(post.data.date)}</span>
              </a>
            ))}
            <a href="/about/">About</a>
          </nav>
        )}
      </section>

      <SkillsMarquee />
    </div>
  </main>
</Layout>
