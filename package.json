{
  "name": "astro-palette",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "A minimal Astro theme for personal sites and blogs",
  "keywords": [
    "astro",
    "withastro",
    "astro-theme",
    "astro-template",
    "blog"
  ],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
