---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
---

<Layout
  title="About - Meow Bread"
  description="Cyber x Puzzle x Art"
  canonicalPath="/about/"
>
  <main class="content-shell" data-pagefind-body>
    <div class="page-hero">
      <h1 class="visually-hidden">About</h1>
      <TypedLede text="Cyber x Puzzle x Art. What happens when the unlikely meets..." />
    </div>

    <div class="section" style="max-width: var(--max);">
      <div class="about-grid">
        <div class="about-me">
          <div class="about-card">
            <h3>About</h3>
            <div class="about-prose">
              <p>I'm a final year Computer Science student and a cyber enthusiast. More of a blue teamer... so do talk to me about things like threat intel and forensics! </p>
              <p>My current obsession is doing Geolocation Puzzles! Exploring the railways of Nordic countries, digging through language differentiators, squinting at stop signs.</p>
              <p>This is just my little personal braindump >.< </p>
            </div>
          </div>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>Education</h3>
            <div class="edu-entry">
              <p class="edu-degree">Computer Science, CyberSecurity</p>
              <p class="edu-school"><a href="https://example.edu" target="_blank" rel="noopener" style="color: var(--accent);">some random university</a> · 2027</p>
            </div>


          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>
